  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget { background-color: #F5F7FB; color: #182230; font-family: "Segoe UI"; }
QFrame#sidebar { background-color: #111B2E; }
QLabel#brandLabel { color: #FFFFFF; font-size: 27px; font-weight: 700; }
QLabel#brandSubtitle { color: #9AA9BF; font-size: 11px; }
QLabel#menuSectionLabel { color: #74839A; font-size: 10px; font-weight: 700; padding: 8px 12px 2px 12px; }
QPushButton#navDashboard, QPushButton#navSchedule, QPushButton#navCandidates, QPushButton#navResults { color: #BAC5D5; background-color: transparent; border: none; border-radius: 8px; padding: 12px; text-align: left; font-size: 13px; }
QPushButton#navDashboard:hover, QPushButton#navSchedule:hover, QPushButton#navCandidates:hover, QPushButton#navResults:hover { background-color: #1D2A40; color: #FFFFFF; }
QPushButton#navDashboard:checked, QPushButton#navSchedule:checked, QPushButton#navCandidates:checked, QPushButton#navResults:checked { background-color: #315FEA; color: #FFFFFF; font-weight: 600; }
QLabel#topbarContext { color: #64748B; font-size: 12px; }
QLabel#topbarUserName { color: #182230; font-size: 12px; font-weight: 600; }
QLabel#topbarUserRole { color: #778399; font-size: 10px; }
QLabel#avatarLabel { color: #315FEA; background-color: #E9EFFF; border-radius: 17px; font-size: 12px; font-weight: 700; padding: 7px; }
QLineEdit#searchInput { background-color: #FFFFFF; color: #182230; border: 1px solid #E3E8F0; border-radius: 8px; padding: 9px 12px; }
QLineEdit#searchInput:focus { border: 1px solid #315FEA; }
QLineEdit#candidateNameInput, QLineEdit#candidateEmailInput, QComboBox#candidateCourseInput, QComboBox#scheduleCandidateInput, QComboBox#scheduleRoundInput, QComboBox#scheduleStaffInput, QDateEdit#scheduleDateInput, QTimeEdit#scheduleTimeInput { background-color: #FFFFFF; color: #263246; border: 1px solid #E2E7EF; border-radius: 7px; padding: 8px 10px; min-height: 20px; }
QLineEdit#candidateNameInput:focus, QLineEdit#candidateEmailInput:focus, QComboBox#candidateCourseInput:focus, QComboBox#scheduleCandidateInput:focus, QComboBox#scheduleRoundInput:focus, QComboBox#scheduleStaffInput:focus, QDateEdit#scheduleDateInput:focus, QTimeEdit#scheduleTimeInput:focus { border: 1px solid #315FEA; }
QPushButton#candidateAddButton, QPushButton#scheduleAddButton { background-color: #315FEA; color: #FFFFFF; border: none; border-radius: 7px; padding: 10px 15px; font-weight: 600; }
QPushButton#candidateAddButton:hover, QPushButton#scheduleAddButton:hover { background-color: #244BCC; }
QFrame#candidateFormCard, QFrame#scheduleFormCard { background-color: #FFFFFF; border: 1px solid #E7EBF2; border-radius: 10px; }
QLabel#candidateFormHeading, QLabel#scheduleFormHeading { color: #273449; font-size: 13px; font-weight: 600; }
QLabel#candidateFormHint, QLabel#scheduleFormHint { color: #8792A5; font-size: 10px; }
QLabel#dashboardTitle, QLabel#scheduleTitle, QLabel#candidatesTitle, QLabel#resultsTitle { color: #172033; font-size: 25px; font-weight: 700; }
QLabel#dashboardSubtitle, QLabel#scheduleSubtitle, QLabel#candidatesSubtitle, QLabel#resultsSubtitle { color: #788499; font-size: 12px; }
QFrame#metricCandidates, QFrame#metricInterviews, QFrame#metricPending { background-color: #FFFFFF; border: 1px solid #E7EBF2; border-radius: 11px; }
QLabel#candidateMetricLabel, QLabel#interviewMetricLabel, QLabel#pendingMetricLabel { color: #748097; font-size: 11px; }
QLabel#candidateMetricValue, QLabel#interviewMetricValue, QLabel#pendingMetricValue { color: #172033; font-size: 27px; font-weight: 700; }
QTableWidget { background-color: #FFFFFF; alternate-background-color: #FAFBFD; border: 1px solid #E7EBF2; border-radius: 9px; gridline-color: #EEF1F5; color: #344054; selection-background-color: #EAF0FF; selection-color: #1D3FA8; }
QTableWidget::item { padding: 8px; border: none; }
QHeaderView::section { background-color: #F8F9FC; color: #69758A; padding: 11px 9px; border: none; border-bottom: 1px solid #E7EBF2; font-size: 11px; font-weight: 600; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #D6DCE7; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }</string>
